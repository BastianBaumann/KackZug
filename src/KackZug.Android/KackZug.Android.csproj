<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RootNamespace>KackZug.Android</RootNamespace>
    <ApplicationId>io.github.bastianbaumann.kackzug</ApplicationId>
    <ApplicationTitle>KackZug</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Debug'">true</EmbedAssembliesIntoApk>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' And Exists('$(LOCALAPPDATA)\Android\Sdk\platforms\android-36')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AppUpdater.Android\AppUpdater.Android.csproj" />
    <ProjectReference Include="..\KackZug.App\KackZug.App.csproj" />
  </ItemGroup>
</Project>
