<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:KackZug.Localization"
             xmlns:vm="using:KackZug.ViewModels"
             xmlns:c="using:KackZug.Controls"
             x:Class="KackZug.Views.ManualEntryView"
             x:DataType="vm:ManualEntryViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="StationPickerTemplate" x:DataType="vm:StationPickerViewModel">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding Label}" Classes="caption" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasSelection}">
                    <TextBlock Text="{Binding Selected.Name, FallbackValue=''}" Classes="body-lg" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding ChangeCommand}">
                        <TextBlock Text="{x:Static l:UiStrings.Manual_Change}" />
                    </Button>
                </Grid>
                <StackPanel Spacing="6" IsVisible="{Binding IsSearchVisible}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding Query}" PlaceholderText="{x:Static l:UiStrings.Manual_StationPlaceholder}" />
                        <Button Grid.Column="1" Classes="secondary" Command="{Binding SearchCommand}">
                            <TextBlock Text="{x:Static l:UiStrings.Manual_Search}" />
                        </Button>
                    </Grid>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearching}" />
                    <TextBlock Text="{Binding Message}" Classes="caption" TextWrapping="Wrap"
                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StationResult">
                                <Button Classes="plain" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ChooseCommand}">
                                    <Border Classes="soft" Padding="12,10" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="16">
        <StackPanel Spacing="2">
            <TextBlock Text="{x:Static l:UiStrings.Manual_Title}" Classes="title" />
            <TextBlock Text="{x:Static l:UiStrings.Manual_Intro}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Legs}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ManualLegViewModel">
                    <Border Classes="soft">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Title}" Classes="label" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="ghost" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <c:OutlineIcon Data="{StaticResource IconDelete}" Width="18" Height="18" />
                                        <TextBlock Text="{x:Static l:UiStrings.Common_Remove}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ContentControl Content="{Binding From}" ContentTemplate="{StaticResource StationPickerTemplate}" />
                            <ContentControl Content="{Binding To}" ContentTemplate="{StaticResource StationPickerTemplate}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Static l:UiStrings.Manual_Departure}" Classes="caption" />
                                    <TextBox Classes="time" HorizontalAlignment="Left" Text="{Binding DepartureText}" PlaceholderText="06:42" MaxLength="8"
                                             TextInputOptions.ContentType="Number" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{x:Static l:UiStrings.Manual_Arrival}" Classes="caption" />
                                    <TextBox Classes="time" HorizontalAlignment="Left" Text="{Binding ArrivalText}" PlaceholderText="07:10" MaxLength="8"
                                             TextInputOptions.ContentType="Number" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Static l:UiStrings.Manual_Line}" Classes="caption" />
                                    <TextBox Text="{Binding LineText}" PlaceholderText="RE 1, Bus 11" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{x:Static l:UiStrings.Manual_TrainNumber}" Classes="caption" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding TrainNumberText}" PlaceholderText="4711" TextInputOptions.ContentType="Digits" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding AddLegCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <c:OutlineIcon Data="{StaticResource IconPlus}" Width="20" Height="20" />
                <TextBlock Text="{x:Static l:UiStrings.Manual_AddLeg}" />
            </StackPanel>
        </Button>

        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource AppCancelInkBrush}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ContinueCommand}">
            <TextBlock Text="{x:Static l:UiStrings.Common_Next}" />
        </Button>
    </StackPanel>
</UserControl>
