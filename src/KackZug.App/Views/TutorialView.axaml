<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:KackZug.Localization"
             xmlns:vm="using:KackZug.ViewModels"
             xmlns:c="using:KackZug.Controls"
             x:Class="KackZug.Views.TutorialView"
             x:DataType="vm:TutorialViewModel">
    <StackPanel Spacing="20">
        <Border Height="140" DataContext="{Binding Current}" x:DataType="vm:TutorialStep">
            <Grid>
                <Image Source="{StaticResource LogoImage}" Width="140" Height="140" IsVisible="{Binding ShowsLogo}" />
                <Border Width="112" Height="112" CornerRadius="56" Background="{DynamicResource AppAccentSoftBrush}"
                        IsVisible="{Binding !ShowsLogo}">
                    <c:OutlineIcon Data="{Binding Icon}" Width="52" Height="52" Foreground="{DynamicResource AppAccentInkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <StackPanel Spacing="8" DataContext="{Binding Current}" x:DataType="vm:TutorialStep">
            <TextBlock Text="{Binding Title}" Classes="title" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center" Classes="muted" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Steps}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TutorialStep">
                    <Border Width="10" Height="10" CornerRadius="5" Classes="dot" Classes.current="{Binding IsCurrent}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="8">
            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding NextCommand}" IsVisible="{Binding IsNotLast}">
                <TextBlock Text="{x:Static l:UiStrings.Common_Next}" />
            </Button>
            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding FinishCommand}" IsVisible="{Binding IsLast}">
                <TextBlock Text="{x:Static l:UiStrings.Tutorial_Start}" />
            </Button>
            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding OpenSettingsCommand}" IsVisible="{Binding IsLast}">
                <TextBlock Text="{x:Static l:UiStrings.Tutorial_ToSettings}" />
            </Button>
            <Grid ColumnDefinitions="*,*">
                <Button Classes="ghost" Command="{Binding BackCommand}" IsVisible="{Binding !IsFirst}" HorizontalAlignment="Left">
                    <TextBlock Text="{x:Static l:UiStrings.Common_Back}" />
                </Button>
                <Button Grid.Column="1" Classes="ghost" Command="{Binding FinishCommand}" IsVisible="{Binding IsNotLast}" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Static l:UiStrings.Tutorial_Skip}" />
                </Button>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
