<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KackZug.ViewModels"
             x:Class="KackZug.Views.TutorialView"
             x:DataType="vm:TutorialViewModel">
    <StackPanel Spacing="18">
        <Border Height="150" DataContext="{Binding Current}" x:DataType="vm:TutorialStep">
            <Grid>
                <Image Source="{StaticResource LogoImage}" Width="150" Height="150" IsVisible="{Binding ShowsLogo}" />
                <Border Width="110" Height="110" CornerRadius="55" Background="{DynamicResource AppAccentSoftBrush}"
                        IsVisible="{Binding !ShowsLogo}">
                    <PathIcon Data="{Binding Icon}" Width="56" Height="56" Foreground="{DynamicResource AppAccentBrush}" />
                </Border>
            </Grid>
        </Border>

        <StackPanel Spacing="8" DataContext="{Binding Current}" x:DataType="vm:TutorialStep">
            <TextBlock Text="{Binding Title}" Classes="h2" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Steps}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TutorialStep">
                    <Border Width="9" Height="9" CornerRadius="5" Classes="dot" Classes.current="{Binding IsCurrent}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Classes="ghost" Command="{Binding BackCommand}" IsVisible="{Binding !IsFirst}">
                <TextBlock Text="Zurück" />
            </Button>
            <Button Grid.Column="0" Classes="icon" Command="{Binding FinishCommand}" IsVisible="{Binding IsFirst}">
                <TextBlock Text="Überspringen" Foreground="{DynamicResource AppMutedBrush}" />
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost" Command="{Binding OpenSettingsCommand}" IsVisible="{Binding IsLast}">
                    <TextBlock Text="Einstellungen" />
                </Button>
                <Button Classes="accent" Command="{Binding NextCommand}" IsVisible="{Binding IsNotLast}">
                    <TextBlock Text="Weiter" />
                </Button>
                <Button Classes="accent" Command="{Binding FinishCommand}" IsVisible="{Binding IsLast}">
                    <TextBlock Text="Los geht's" />
                </Button>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
