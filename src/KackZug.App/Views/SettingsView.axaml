<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KackZug.ViewModels"
             xmlns:services="using:KackZug.Services"
             xmlns:c="using:KackZug.Controls"
             x:Class="KackZug.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="4">
            <TextBlock Text="{Binding Title}" Classes="title-lg" Margin="0,0,0,8" />

            <TextBlock Text="Damit Alarme sicher ankommen" Classes="section" />
            <Border Classes="group">
                <ItemsControl ItemsSource="{Binding Permissions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:PermissionInfo">
                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Classes="body-lg" />
                                        <TextBlock Text="{Binding Explanation}" Classes="caption" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border Classes="badge" Background="{DynamicResource AppOkBrush}" IsVisible="{Binding Granted}" HorizontalAlignment="Right">
                                            <TextBlock Text="Erlaubt" Foreground="{DynamicResource AppOnOkBrush}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Classes="badge" Background="{DynamicResource AppCancelBrush}" IsVisible="{Binding Missing}" HorizontalAlignment="Right">
                                            <TextBlock Text="Fehlt" Foreground="{DynamicResource AppOnCancelBrush}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        </Border>
                                        <Button Classes="ghost" IsVisible="{Binding Missing}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).FixPermissionCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="Erlauben" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="4,6,4,0" IsVisible="{Binding HasNoPermissions}"
                       Text="Auf dem Desktop gibt es hier nichts zu erlauben." />

            <TextBlock Text="Wann geprüft wird" Classes="section" />
            <Border Classes="group">
                <StackPanel>
                    <Border Classes="setting">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Vor der ersten Abfahrt" Classes="body-lg" />
                                <TextBlock Text="Echtzeit gibt es meist erst kurz vorher." Classes="caption" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding LeadTimes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LeadTimeOption">
                                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Text}" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Classes="setting">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Am Abend vorher prüfen" Classes="body-lg" />
                                <TextBlock Text="Meist nur laut Fahrplan, Echtzeit folgt später." Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EveningCheckEnabled}" OnContent="" OffContent="" />
                        </Grid>
                    </Border>
                    <Border Classes="setting" IsVisible="{Binding EveningCheckEnabled}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Uhrzeit" Classes="body-lg" VerticalAlignment="Center" />
                            <TimePicker Grid.Column="1" SelectedTime="{Binding EveningCheckTime}" ClockIdentifier="24HourClock" MinuteIncrement="5" />
                        </Grid>
                    </Border>
                    <Border Classes="setting" BorderThickness="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Auch melden, wenn alles im Plan ist" Classes="body-lg" TextWrapping="Wrap" />
                                <TextBlock Text="Kurze Info beim Abend-Check." Classes="caption" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EveningOkNotification}" OnContent="" OffContent="" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Was gemeldet wird" Classes="section" />
            <Border Classes="group">
                <StackPanel>
                    <Border Classes="setting">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Verspätung ab" Classes="body-lg" />
                                <TextBlock Text="Minuten" Classes="caption" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Value="{Binding DelayThreshold}" Minimum="1" Maximum="60" Increment="1" FormatString="0" Width="130" />
                        </Grid>
                    </Border>
                    <Border Classes="setting">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Zeit zum Umsteigen" Classes="body-lg" />
                                <TextBlock Text="Minuten zusätzlich zum Fußweg" Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Value="{Binding MinTransfer}" Minimum="0" Maximum="30" Increment="1" FormatString="0" Width="130" />
                        </Grid>
                    </Border>
                    <Border Classes="setting">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Alarm wiederholen" Classes="body-lg" />
                                <TextBlock Text="Klingelt, bis du „Gesehen“ tippst." Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding InsistentAlerts}" OnContent="" OffContent="" />
                        </Grid>
                    </Border>
                    <Border Classes="setting" BorderThickness="0">
                        <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding TestAlarmCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:OutlineIcon Data="{StaticResource IconBell}" Width="20" Height="20" />
                                <TextBlock Text="Test-Alarm in 5 Sekunden" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Neue Woche" Classes="section" />
            <Border Classes="group">
                <StackPanel>
                    <Border Classes="setting">
                        <RadioButton GroupName="week" IsChecked="{Binding CopyPreviousWeek}" VerticalAlignment="Center">
                            <TextBlock Text="Plan der Vorwoche übernehmen" Classes="body-lg" />
                        </RadioButton>
                    </Border>
                    <Border Classes="setting" BorderThickness="0">
                        <RadioButton GroupName="week" IsChecked="{Binding StartWeekEmpty}" VerticalAlignment="Center">
                            <TextBlock Text="Leer beginnen" Classes="body-lg" />
                        </RadioButton>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Aussehen" Classes="section" />
            <Border Classes="group">
                <StackPanel>
                    <Border Classes="setting">
                        <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="8" Padding="4" VerticalAlignment="Center">
                            <UniformGrid Rows="1">
                                <RadioButton Classes="segment" GroupName="theme" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding ThemeSystem}">
                                    <TextBlock Text="System" />
                                </RadioButton>
                                <RadioButton Classes="segment" GroupName="theme" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding ThemeLight}">
                                    <TextBlock Text="Hell" />
                                </RadioButton>
                                <RadioButton Classes="segment" GroupName="theme" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding ThemeDark}">
                                    <TextBlock Text="Dunkel" />
                                </RadioButton>
                            </UniformGrid>
                        </Border>
                    </Border>
                    <Border Classes="setting" BorderThickness="0">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Markenfarbe" Classes="body-lg" />
                                    <TextBlock Text="Standard ist das Orange aus dem Logo." Classes="caption" />
                                </StackPanel>
                                <ColorPicker Grid.Column="1" Color="{Binding AccentColor}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ColorPreset">
                                        <Button Classes="secondary" MinHeight="44" Margin="0,0,8,8"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApplyPresetCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="20" Height="20" CornerRadius="10" Background="{Binding Brush}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Updates" Classes="section" />
            <Border Classes="group">
                <Border Classes="setting" BorderThickness="0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Nach neuer Version schauen" Classes="body-lg" />
                            <TextBlock Text="Einmal am Tag auf GitHub." Classes="caption" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding UpdateCheckEnabled}" OnContent="" OffContent="" />
                    </Grid>
                </Border>
            </Border>

            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,16,0,0" Command="{Binding ShowTutorialCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:OutlineIcon Data="{StaticResource IconUnknown}" Width="20" Height="20" />
                    <TextBlock Text="Einführung noch einmal ansehen" />
                </StackPanel>
            </Button>

            <StackPanel Spacing="4" Margin="4,16,4,16">
                <TextBlock Text="{Binding VersionText}" Classes="caption" TextWrapping="Wrap" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="KackZug ist ein privates Open-Source-Projekt und hat nichts mit der Deutschen Bahn zu tun. Die Daten kommen von bahn.de." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
