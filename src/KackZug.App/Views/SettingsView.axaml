<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KackZug.ViewModels"
             xmlns:services="using:KackZug.Services"
             x:Class="KackZug.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12">
            <TextBlock Text="{Binding Title}" Classes="h1" />

            <Border Classes="card" IsVisible="{Binding HasMissingPermissions}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="2">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconWarning}" Width="20" Height="20" Foreground="{DynamicResource AppWarningBrush}" />
                        <TextBlock Text="Damit Alarme sicher ankommen" Classes="h3" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Permissions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:PermissionInfo">
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Missing}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" Margin="8,0,0,0"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).FixPermissionCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="Erlauben" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Wann geprüft wird" Classes="h3" />
                    <TextBlock Text="Vor der ersten Abfahrt" Classes="label" />
                    <ItemsControl ItemsSource="{Binding LeadTimes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LeadTimeOption">
                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Text}" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox IsChecked="{Binding EveningCheckEnabled}">
                        <TextBlock Text="Am Abend vorher prüfen" />
                    </CheckBox>
                    <TimePicker SelectedTime="{Binding EveningCheckTime}" ClockIdentifier="24HourClock" MinuteIncrement="5"
                                IsEnabled="{Binding EveningCheckEnabled}" />
                    <CheckBox IsChecked="{Binding EveningOkNotification}" IsEnabled="{Binding EveningCheckEnabled}">
                        <TextBlock Text="Am Abend auch melden, wenn alles planmäßig ist" TextWrapping="Wrap" />
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Was gemeldet wird" Classes="h3" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Verspätung melden ab (Min.)" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <NumericUpDown Grid.Column="1" Value="{Binding DelayThreshold}" Minimum="1" Maximum="60" Increment="1" FormatString="0" Width="130" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Mindestzeit zum Umsteigen (Min.)" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <NumericUpDown Grid.Column="1" Value="{Binding MinTransfer}" Minimum="0" Maximum="30" Increment="1" FormatString="0" Width="130" />
                    </Grid>
                    <CheckBox IsChecked="{Binding InsistentAlerts}">
                        <TextBlock Text="Alarmton wiederholen, bis ich reagiere" TextWrapping="Wrap" />
                    </CheckBox>
                    <Button Classes="ghost" Command="{Binding TestAlarmCommand}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconBell}" Width="16" Height="16" />
                            <TextBlock Text="Test-Alarm in 5 Sekunden" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Neue Woche" Classes="h3" />
                    <RadioButton GroupName="week" IsChecked="{Binding CopyPreviousWeek}">
                        <TextBlock Text="Plan der Vorwoche übernehmen" />
                    </RadioButton>
                    <RadioButton GroupName="week" IsChecked="{Binding StartWeekEmpty}">
                        <TextBlock Text="Leer beginnen" />
                    </RadioButton>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Aussehen" Classes="h3" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <RadioButton GroupName="theme" IsChecked="{Binding ThemeSystem}">
                            <TextBlock Text="System" />
                        </RadioButton>
                        <RadioButton GroupName="theme" IsChecked="{Binding ThemeLight}">
                            <TextBlock Text="Hell" />
                        </RadioButton>
                        <RadioButton GroupName="theme" IsChecked="{Binding ThemeDark}">
                            <TextBlock Text="Dunkel" />
                        </RadioButton>
                    </StackPanel>
                    <TextBlock Text="Farben" Classes="label" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ColorPicker Color="{Binding AccentColor}" />
                        <ColorPicker Color="{Binding SecondaryColor}" />
                    </StackPanel>
                    <TextBlock Text="Vorlagen" Classes="label" />
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ColorPreset">
                                <Button Classes="ghost" Margin="0,0,8,8"
                                        Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApplyPresetCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Brush}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Updates" Classes="h3" />
                    <CheckBox IsChecked="{Binding UpdateCheckEnabled}">
                        <TextBlock Text="Einmal am Tag auf GitHub nach einer neuen Version schauen" TextWrapping="Wrap" />
                    </CheckBox>
                </StackPanel>
            </Border>

            <StackPanel Spacing="4" Margin="4,4,4,12">
                <TextBlock Text="{Binding VersionText}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="KackZug ist ein privates Open-Source-Projekt und hat nichts mit der Deutschen Bahn zu tun. Die Daten kommen von bahn.de." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
