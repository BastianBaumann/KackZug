<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KackZug.ViewModels"
             xmlns:c="using:KackZug.Controls"
             x:Class="KackZug.Views.WeekView"
             x:DataType="vm:WeekViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="DetailLegTemplate" x:DataType="vm:LegDetailLine">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="64,0,0,12" IsVisible="{Binding IsWalk}">
                    <c:OutlineIcon Data="{StaticResource IconTransfer}" Width="18" Height="18" Foreground="{DynamicResource AppMutedBrush}" />
                    <TextBlock Text="{Binding Details}" Classes="caption" VerticalAlignment="Center" />
                </StackPanel>
                <Grid ColumnDefinitions="56,20,*" RowDefinitions="Auto,Auto,Auto,Auto" IsVisible="{Binding !IsWalk}" Margin="0,0,0,12">
                    <TextBlock Grid.Row="0" Text="{Binding DepartureTime}" Classes="time body-lg" />
                    <TextBlock Grid.Row="3" Text="{Binding ArrivalTime}" Classes="time body-lg" Margin="0,8,0,0" />
                    <Grid Grid.Column="1" Grid.RowSpan="4" RowDefinitions="Auto,*,Auto">
                        <Ellipse Grid.Row="0" Width="14" Height="14" Margin="0,5,0,0" Stroke="{DynamicResource AppTextBrush}" StrokeThickness="3" Fill="{DynamicResource AppSurfaceBrush}" />
                        <Rectangle Grid.Row="1" Width="3" Fill="{DynamicResource AppTextBrush}" />
                        <Ellipse Grid.Row="2" Width="14" Height="14" Margin="0,0,0,5" Stroke="{DynamicResource AppTextBrush}" StrokeThickness="3" Fill="{DynamicResource AppSurfaceBrush}" />
                    </Grid>
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding FromName}" Classes="body-lg" TextWrapping="Wrap" Margin="8,0,0,0" />
                    <WrapPanel Grid.Column="2" Grid.Row="1" Margin="8,4,0,0">
                        <Border Classes="line-tag" Margin="0,0,8,4">
                            <TextBlock Text="{Binding LineName}" FontSize="13" FontWeight="Bold" />
                        </Border>
                        <ContentControl Content="{Binding Badge}" ContentTemplate="{StaticResource BadgeTemplate}" Margin="0,0,8,4"
                                        IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{Binding Meta}" Classes="caption" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Grid.Column="2" Grid.Row="2" Text="{Binding LiveText}" Classes="caption" Foreground="{DynamicResource AppLateInkBrush}"
                               TextWrapping="Wrap" Margin="8,2,0,0" IsVisible="{Binding LiveText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Grid.Column="2" Grid.Row="3" Text="{Binding ToName}" Classes="body-lg" TextWrapping="Wrap" Margin="8,8,0,0" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" IsVisible="{Binding IsListVisible}">
        <StackPanel Margin="16" Spacing="12">
            <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="8" Padding="4">
                <UniformGrid Rows="1">
                    <RadioButton Classes="segment" GroupName="week" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsThisWeek}">
                        <TextBlock Text="Diese Woche" />
                    </RadioButton>
                    <RadioButton Classes="segment" GroupName="week" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsNextWeek}">
                        <TextBlock Text="Nächste Woche" />
                    </RadioButton>
                </UniformGrid>
            </Border>

            <StackPanel Spacing="2">
                <TextBlock Text="{Binding WeekTitle}" Classes="title-lg" />
                <TextBlock Text="{Binding WeekText}" Classes="caption" />
            </StackPanel>

            <Border Classes="card" IsVisible="{Binding HasNoShifts}">
                <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="8,16">
                    <c:OutlineIcon Data="{StaticResource IconShare}" Width="48" Height="48" StrokeThickness="1.5" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Noch keine Schicht" Classes="title" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Classes="muted"
                               Text="Tipp im DB Navigator bei deiner Verbindung auf „Teilen“ und wähl KackZug. Dann gibst du hier jedem Tag eine Schicht." />
                </StackPanel>
            </Border>

            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding CheckNowCommand}" IsVisible="{Binding !HasNoShifts}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:OutlineIcon Data="{StaticResource IconRefresh}" Width="20" Height="20" />
                    <TextBlock Text="Jetzt prüfen (heute und morgen)" />
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsChecking}" />
            <Border Classes="soft" IsVisible="{Binding CheckResult, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding CheckResult}" TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayRowViewModel">
                        <Border Classes="day" Classes.today="{Binding IsToday}" Classes.past="{Binding IsPast}">
                            <Grid ColumnDefinitions="6,56,*">
                                <Border Grid.Column="0" Background="{Binding StripeBrush}" />
                                <StackPanel Grid.Column="1" Margin="12,12,0,12" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsMarked}" IsVisible="{Binding CanMark}" Margin="0,0,0,4" />
                                    <TextBlock Text="HEUTE" Classes="kicker" IsVisible="{Binding IsToday}" />
                                    <TextBlock Text="{Binding WeekdayShort}" Classes="title" FontWeight="Bold" />
                                    <TextBlock Text="{Binding DateText}" Classes="caption" FontFeatures="+tnum" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,12,12,12" Spacing="8" VerticalAlignment="Center">
                                    <WrapPanel>
                                        <ComboBox Classes="shift" Margin="0,0,8,6" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                                  IsEnabled="{Binding IsEditable}" Background="{Binding ShiftBrush}" Foreground="{Binding ShiftForeground}"
                                                  HorizontalAlignment="Left" MinWidth="130">
                                            <ComboBox.SelectionBoxItemTemplate>
                                                <DataTemplate x:DataType="vm:ShiftOption">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               Foreground="{Binding $parent[ComboBox].Foreground}" />
                                                </DataTemplate>
                                            </ComboBox.SelectionBoxItemTemplate>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ShiftOption">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ContentControl Margin="0,0,0,6" VerticalAlignment="Center"
                                                        Content="{Binding DayBadge}" ContentTemplate="{StaticResource BadgeTemplate}"
                                                        IsVisible="{Binding DayBadge, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </WrapPanel>
                                    <WrapPanel IsVisible="{Binding HasShift}">
                                        <ToggleButton Classes="trip" Margin="0,0,8,4" IsChecked="{Binding OutboundEnabled}"
                                                      IsEnabled="{Binding CanToggleOutbound}" IsVisible="{Binding HasOutbound}">
                                            <TextBlock Text="{Binding OutboundLabel}" />
                                        </ToggleButton>
                                        <ToggleButton Classes="trip" Margin="0,0,8,4" IsChecked="{Binding ReturnEnabled}"
                                                      IsEnabled="{Binding CanToggleReturn}" IsVisible="{Binding HasReturn}">
                                            <TextBlock Text="{Binding ReturnLabel}" />
                                        </ToggleButton>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding OutboundCaption}" Classes="caption" TextWrapping="Wrap"
                                               IsVisible="{Binding OutboundCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding ReturnCaption}" Classes="caption" TextWrapping="Wrap"
                                               IsVisible="{Binding ReturnCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <Button Classes="ghost" Padding="0" MinHeight="36" HorizontalAlignment="Left" IsVisible="{Binding HasShift}"
                                            Command="{Binding $parent[UserControl].((vm:WeekViewModel)DataContext).OpenDetailCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Details" />
                                            <c:OutlineIcon Data="{StaticResource IconArrow}" Width="16" Height="16" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding StartSelectingCommand}" CommandParameter="{x:Null}"
                    IsVisible="{Binding !IsSelecting}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:OutlineIcon Data="{StaticResource IconWeek}" Width="20" Height="20" />
                    <TextBlock Text="Mehrere Tage setzen" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Row="0" IsVisible="{Binding HasDetail}">
        <ContentControl Content="{Binding Detail}" Margin="16">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:TripDetailViewModel">
                    <StackPanel Spacing="12">
                        <Button Classes="ghost" Padding="0" HorizontalAlignment="Left" Command="{Binding CloseCommand}">
                            <TextBlock Text="‹ Zurück zur Woche" />
                        </Button>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Heading}" Classes="title-lg" />
                            <TextBlock Text="{Binding ShiftName}" Classes="caption" />
                        </StackPanel>
                        <TextBlock Text="An diesem Tag ist keine Fahrt eingeschaltet." Classes="muted" IsVisible="{Binding HasNoTrips}" />
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsChecking}" />
                        <ItemsControl ItemsSource="{Binding Trips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TripCardViewModel">
                                    <Border Classes="card">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{Binding Title}" Classes="title" />
                                            <WrapPanel>
                                                <TextBlock Text="{Binding BigTime}" FontSize="40" LineHeight="44" FontWeight="Bold" FontFeatures="+tnum" Margin="0,0,12,0"
                                                           Classes.cancelled="{Binding IsCancelled}" VerticalAlignment="Center" />
                                                <ContentControl Content="{Binding Badge}" ContentTemplate="{StaticResource BadgeTemplate}" VerticalAlignment="Center"
                                                                IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding NowText}" Classes="label" Foreground="{DynamicResource AppLateInkBrush}" FontFeatures="+tnum"
                                                       IsVisible="{Binding NowText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <ItemsControl ItemsSource="{Binding Legs}" ItemTemplate="{StaticResource DetailLegTemplate}" />
                                            <ItemsControl ItemsSource="{Binding Notes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}" Classes="caption" TextWrapping="Wrap" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding CheckedText}" Classes="caption" />
                                            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding OpenInNavigatorCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <c:OutlineIcon Data="{StaticResource IconTrain}" Width="20" Height="20" />
                                                    <TextBlock Text="Im DB Navigator öffnen" IsVisible="{Binding !IsPreparingNavigator}" />
                                                    <TextBlock Text="Verbindung wird vorbereitet …" IsVisible="{Binding IsPreparingNavigator}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding RefreshCommand}"
                                IsVisible="{Binding !HasNoTrips}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:OutlineIcon Data="{StaticResource IconRefresh}" Width="20" Height="20" />
                                <TextBlock Text="Live prüfen" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </ScrollViewer>

    <Border Grid.Row="1" IsVisible="{Binding IsSelecting}" Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12" BoxShadow="{DynamicResource AppSheetShadow}">
        <StackPanel Spacing="10">
            <TextBlock Text="Markierte Tage bekommen diese Schicht:" Classes="caption" />
            <ComboBox ItemsSource="{Binding BulkOptions}" SelectedItem="{Binding BulkOption}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShiftOption">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <UniformGrid Rows="1">
                <Button Classes="secondary" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CancelSelectingCommand}">
                    <TextBlock Text="Abbrechen" />
                </Button>
                <Button Classes="primary" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ApplySelectionCommand}">
                    <TextBlock Text="Übernehmen" />
                </Button>
            </UniformGrid>
        </StackPanel>
    </Border>
    </Grid>
</UserControl>
