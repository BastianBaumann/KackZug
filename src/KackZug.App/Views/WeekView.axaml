<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KackZug.ViewModels"
             xmlns:c="using:KackZug.Controls"
             x:Class="KackZug.Views.WeekView"
             x:DataType="vm:WeekViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock Text="Diese Woche" Classes="title-lg" />
                <TextBlock Text="{Binding WeekText}" Classes="caption" />
            </StackPanel>

            <Border Classes="card" IsVisible="{Binding HasNoShifts}">
                <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="8,16">
                    <c:OutlineIcon Data="{StaticResource IconShare}" Width="48" Height="48" StrokeThickness="1.5" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Noch keine Schicht" Classes="title" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Classes="muted"
                               Text="Tipp im DB Navigator bei deiner Verbindung auf „Teilen“ und wähl KackZug. Dann gibst du hier jedem Tag eine Schicht." />
                </StackPanel>
            </Border>

            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding CheckNowCommand}" IsVisible="{Binding !HasNoShifts}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:OutlineIcon Data="{StaticResource IconRefresh}" Width="20" Height="20" />
                    <TextBlock Text="Jetzt prüfen (heute und morgen)" />
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsChecking}" />
            <Border Classes="soft" IsVisible="{Binding CheckResult, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding CheckResult}" TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayRowViewModel">
                        <Border Classes="day" Classes.today="{Binding IsToday}" Classes.past="{Binding IsPast}">
                            <Grid ColumnDefinitions="6,56,*">
                                <Border Grid.Column="0" Background="{Binding StripeBrush}" />
                                <StackPanel Grid.Column="1" Margin="12,12,0,12" VerticalAlignment="Center">
                                    <TextBlock Text="HEUTE" Classes="kicker" IsVisible="{Binding IsToday}" />
                                    <TextBlock Text="{Binding WeekdayShort}" Classes="title" FontWeight="Bold" />
                                    <TextBlock Text="{Binding DateText}" Classes="caption" FontFeatures="+tnum" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,12,12,12" Spacing="8" VerticalAlignment="Center">
                                    <WrapPanel>
                                        <ComboBox Classes="shift" Margin="0,0,8,6" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                                  IsEnabled="{Binding IsEditable}" Background="{Binding ShiftBrush}" Foreground="{Binding ShiftForeground}"
                                                  HorizontalAlignment="Left" MinWidth="130">
                                            <ComboBox.SelectionBoxItemTemplate>
                                                <DataTemplate x:DataType="vm:ShiftOption">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               Foreground="{Binding $parent[ComboBox].Foreground}" />
                                                </DataTemplate>
                                            </ComboBox.SelectionBoxItemTemplate>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ShiftOption">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ContentControl Margin="0,0,0,6" VerticalAlignment="Center"
                                                        Content="{Binding DayBadge}" ContentTemplate="{StaticResource BadgeTemplate}"
                                                        IsVisible="{Binding DayBadge, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </WrapPanel>
                                    <WrapPanel IsVisible="{Binding HasShift}">
                                        <ToggleButton Classes="trip" Margin="0,0,8,4" IsChecked="{Binding OutboundEnabled}"
                                                      IsEnabled="{Binding CanToggleOutbound}" IsVisible="{Binding HasOutbound}">
                                            <TextBlock Text="{Binding OutboundLabel}" />
                                        </ToggleButton>
                                        <ToggleButton Classes="trip" Margin="0,0,8,4" IsChecked="{Binding ReturnEnabled}"
                                                      IsEnabled="{Binding CanToggleReturn}" IsVisible="{Binding HasReturn}">
                                            <TextBlock Text="{Binding ReturnLabel}" />
                                        </ToggleButton>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding OutboundCaption}" Classes="caption" TextWrapping="Wrap"
                                               IsVisible="{Binding OutboundCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding ReturnCaption}" Classes="caption" TextWrapping="Wrap"
                                               IsVisible="{Binding ReturnCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
