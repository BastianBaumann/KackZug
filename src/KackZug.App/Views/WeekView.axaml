<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:KackZug.Localization"
             xmlns:vm="using:KackZug.ViewModels"
             xmlns:c="using:KackZug.Controls"
             x:Class="KackZug.Views.WeekView"
             x:DataType="vm:WeekViewModel">
    <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" IsVisible="{Binding IsListVisible}">
        <StackPanel Margin="16" Spacing="12">
            <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="8" Padding="4">
                <UniformGrid Rows="1">
                    <RadioButton Classes="segment" GroupName="week" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsThisWeek}">
                        <TextBlock Text="{x:Static l:UiStrings.Week_ThisWeek}" />
                    </RadioButton>
                    <RadioButton Classes="segment" GroupName="week" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsNextWeek}">
                        <TextBlock Text="{x:Static l:UiStrings.Week_NextWeek}" />
                    </RadioButton>
                </UniformGrid>
            </Border>

            <StackPanel Spacing="2">
                <TextBlock Text="{Binding WeekTitle}" Classes="title-lg" />
                <TextBlock Text="{Binding WeekText}" Classes="caption" />
            </StackPanel>

            <Border Classes="card" IsVisible="{Binding HasNoShifts}">
                <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="8,16">
                    <c:OutlineIcon Data="{StaticResource IconShare}" Width="48" Height="48" StrokeThickness="1.5" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static l:UiStrings.Week_NoShiftTitle}" Classes="title" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Classes="muted"
                               Text="{x:Static l:UiStrings.Week_NoShiftText}" />
                </StackPanel>
            </Border>

            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding CheckNowCommand}" IsVisible="{Binding !HasNoShifts}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:OutlineIcon Data="{StaticResource IconRefresh}" Width="20" Height="20" />
                    <TextBlock Text="{x:Static l:UiStrings.Week_CheckNow}" />
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsChecking}" />

            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayRowViewModel">
                        <Border Classes="day" Classes.today="{Binding IsToday}" Classes.past="{Binding IsPast}">
                            <Grid ColumnDefinitions="6,56,*">
                                <Border Grid.Column="0" Background="{Binding StripeBrush}" />
                                <StackPanel Grid.Column="1" Margin="12,12,0,12" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsMarked}" IsVisible="{Binding CanMark}" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Static l:UiStrings.Week_Today}" Classes="kicker" IsVisible="{Binding IsToday}" />
                                    <TextBlock Text="{Binding WeekdayShort}" Classes="title" FontWeight="Bold" />
                                    <TextBlock Text="{Binding DateText}" Classes="caption" FontFeatures="+tnum" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,12,12,12" Spacing="8" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ComboBox Classes="shift" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                                  IsEnabled="{Binding IsEditable}" Background="{Binding ShiftBrush}" Foreground="{Binding ShiftForeground}"
                                                  HorizontalAlignment="Left" MinWidth="130">
                                            <ComboBox.SelectionBoxItemTemplate>
                                                <DataTemplate x:DataType="vm:ShiftOption">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               Foreground="{Binding $parent[ComboBox].Foreground}" />
                                                </DataTemplate>
                                            </ComboBox.SelectionBoxItemTemplate>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ShiftOption">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1" Classes="ghost" Padding="8,0" MinHeight="40" VerticalAlignment="Center" IsVisible="{Binding HasShift}"
                                                Command="{Binding $parent[UserControl].((vm:WeekViewModel)DataContext).OpenDetailCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{x:Static l:UiStrings.Week_Details}" />
                                                <c:OutlineIcon Data="{StaticResource IconArrow}" Width="16" Height="16" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid Classes="trip-line" ColumnDefinitions="Auto,*" IsVisible="{Binding HasOutbound}">
                                        <ToggleButton Classes="trip" VerticalAlignment="Center" IsChecked="{Binding OutboundEnabled}" IsEnabled="{Binding CanToggleOutbound}">
                                            <TextBlock Text="{Binding OutboundLabel}" />
                                        </ToggleButton>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2" VerticalAlignment="Center">
                                            <ContentControl HorizontalAlignment="Right"
                                                            Content="{Binding OutboundStatus}" ContentTemplate="{StaticResource BadgeTemplate}"
                                                            IsVisible="{Binding OutboundStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Classes="caption" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding OutboundChecked}"
                                                       IsVisible="{Binding OutboundChecked, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Classes="caption" HorizontalAlignment="Right" IsVisible="{Binding OutboundOff}"
                                                       Text="{x:Static l:UiStrings.Day_TripOff}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Classes="trip-line" ColumnDefinitions="Auto,*" IsVisible="{Binding HasReturn}">
                                        <ToggleButton Classes="trip" VerticalAlignment="Center" IsChecked="{Binding ReturnEnabled}" IsEnabled="{Binding CanToggleReturn}">
                                            <TextBlock Text="{Binding ReturnLabel}" />
                                        </ToggleButton>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2" VerticalAlignment="Center">
                                            <ContentControl HorizontalAlignment="Right"
                                                            Content="{Binding ReturnStatus}" ContentTemplate="{StaticResource BadgeTemplate}"
                                                            IsVisible="{Binding ReturnStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Classes="caption" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding ReturnChecked}"
                                                       IsVisible="{Binding ReturnChecked, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Classes="caption" HorizontalAlignment="Right" IsVisible="{Binding ReturnOff}"
                                                       Text="{x:Static l:UiStrings.Day_TripOff}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding StartSelectingCommand}" CommandParameter="{x:Null}"
                    IsVisible="{Binding !IsSelecting}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:OutlineIcon Data="{StaticResource IconWeek}" Width="20" Height="20" />
                    <TextBlock Text="{x:Static l:UiStrings.Week_SetSeveralDays}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Row="0" IsVisible="{Binding HasDetail}">
        <ContentControl Content="{Binding Detail}" Margin="16" ContentTemplate="{StaticResource TripDetailTemplate}" />
    </ScrollViewer>

    <Border Grid.Row="1" IsVisible="{Binding IsSelecting}" Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12" BoxShadow="{DynamicResource AppSheetShadow}">
        <StackPanel Spacing="10">
            <TextBlock Text="{x:Static l:UiStrings.Week_BulkPrompt}" Classes="caption" />
            <ComboBox ItemsSource="{Binding BulkOptions}" SelectedItem="{Binding BulkOption}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShiftOption">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <UniformGrid Rows="1">
                <Button Classes="secondary" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CancelSelectingCommand}">
                    <TextBlock Text="{x:Static l:UiStrings.Common_Cancel}" />
                </Button>
                <Button Classes="primary" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ApplySelectionCommand}">
                    <TextBlock Text="{x:Static l:UiStrings.Common_Apply}" />
                </Button>
            </UniformGrid>
        </StackPanel>
    </Border>
    </Grid>
</UserControl>
