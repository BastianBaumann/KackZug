<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KackZug.ViewModels"
             x:Class="KackZug.Views.WeekView"
             x:DataType="vm:WeekViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" Classes="h1" />
                <TextBlock Text="{Binding WeekText}" Classes="muted" />
            </StackPanel>

            <Border Classes="card" IsVisible="{Binding HasNoShifts}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Noch keine Schicht" Classes="h3" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Teile zuerst eine Verbindung aus dem DB Navigator mit KackZug. Danach kannst du hier jedem Tag eine Schicht geben." />
                </StackPanel>
            </Border>

            <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding CheckNowCommand}" IsVisible="{Binding !HasNoShifts}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16" Foreground="White" />
                    <TextBlock Text="Jetzt prüfen (heute und morgen)" />
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsChecking}" />
            <Border Classes="soft" IsVisible="{Binding CheckResult, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding CheckResult}" TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayRowViewModel">
                        <Border Classes="card" Classes.today="{Binding IsToday}" Classes.past="{Binding IsPast}" Padding="12,10">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DayName}" Classes="h3" />
                                        <TextBlock Text="{Binding DateText}" Classes="muted" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" MinWidth="150" ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding SelectedOption}" IsEnabled="{Binding IsEditable}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ShiftOption">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <WrapPanel IsVisible="{Binding HasShift}">
                                    <ToggleButton Margin="0,0,8,4" IsChecked="{Binding OutboundEnabled}" IsEnabled="{Binding CanToggleOutbound}">
                                        <TextBlock Text="Hinfahrt" />
                                    </ToggleButton>
                                    <ToggleButton Margin="0,0,8,4" IsChecked="{Binding ReturnEnabled}" IsEnabled="{Binding CanToggleReturn}">
                                        <TextBlock Text="Rückfahrt" />
                                    </ToggleButton>
                                </WrapPanel>
                                <StackPanel Spacing="3" IsVisible="{Binding HasShift}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" DataContext="{Binding OutboundStatus}" x:DataType="vm:StatusBadge"
                                                IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Text}" FontSize="13" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" DataContext="{Binding ReturnStatus}" x:DataType="vm:StatusBadge"
                                                IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Text}" FontSize="13" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
