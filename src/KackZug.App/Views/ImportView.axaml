<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KackZug.ViewModels"
             x:Class="KackZug.Views.ImportView"
             x:DataType="vm:ImportViewModel">
    <StackPanel Spacing="14">
        <TextBlock Text="Verbindung übernehmen" Classes="h2" />

        <StackPanel IsVisible="{Binding IsLoading}" Spacing="10">
            <ProgressBar IsIndeterminate="True" />
            <TextBlock Text="Verbindung wird bei bahn.de geladen …" Classes="muted" />
        </StackPanel>

        <StackPanel IsVisible="{Binding HasError}" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconWarning}" Width="22" Height="22" Foreground="{DynamicResource AppDangerBrush}" />
                <TextBlock Text="Das hat nicht geklappt" Classes="h3" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            <Button Classes="ghost" HorizontalAlignment="Right" Command="{Binding CloseCommand}">
                <TextBlock Text="Schließen" />
            </Button>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsReady}" Spacing="14">
            <Border Classes="soft">
                <ItemsControl ItemsSource="{Binding Legs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegLine">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Times}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Route}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Details}" Classes="muted" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Gespeichert werden Bahnhöfe, Uhrzeiten und Zug, nicht das Datum. Die Fahrt gilt dann an jedem Tag mit dieser Schicht." />
            <TextBlock Text="{Binding Hint}" IsVisible="{Binding Hint, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Classes="muted" TextWrapping="Wrap" Foreground="{DynamicResource AppWarningBrush}" />

            <StackPanel Spacing="6">
                <TextBlock Text="Für welche Schicht?" Classes="label" />
                <ItemsControl ItemsSource="{Binding Targets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImportTarget">
                            <ToggleButton Margin="0,0,8,8" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding $parent[UserControl].((vm:ImportViewModel)DataContext).SelectTargetCommand}"
                                          CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Title}" />
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Text="{Binding NewShiftName}" PlaceholderText="Name der neuen Schicht, z. B. Frühdienst"
                         IsVisible="{Binding IsNewTarget}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Als" Classes="label" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton IsChecked="{Binding IsOutbound, Mode=OneWay}" Command="{Binding ChooseOutboundCommand}">
                        <TextBlock Text="Hinfahrt" />
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsReturn, Mode=OneWay}" Command="{Binding ChooseReturnCommand}">
                        <TextBlock Text="Rückfahrt" />
                    </ToggleButton>
                </StackPanel>
            </StackPanel>

            <Border Classes="soft" IsVisible="{Binding HasReplacement}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Die vorhandene Fahrt wird ersetzt" Classes="h3" />
                    <TextBlock Text="Bisher" Classes="label" Margin="0" />
                    <TextBlock Text="{Binding ReplacedSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="Neu" Classes="label" Margin="0" />
                    <TextBlock Text="{Binding NewSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Command="{Binding CloseCommand}">
                    <TextBlock Text="Abbrechen" />
                </Button>
                <Button Classes="accent" Command="{Binding SaveCommand}">
                    <TextBlock Text="Speichern" />
                </Button>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
