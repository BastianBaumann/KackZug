<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:KackZug.Localization"
             xmlns:vm="using:KackZug.ViewModels"
             xmlns:c="using:KackZug.Controls"
             x:Class="KackZug.Views.ImportView"
             x:DataType="vm:ImportViewModel">
    <StackPanel Spacing="16">
        <StackPanel IsVisible="{Binding IsLoading}" Spacing="12">
            <TextBlock Text="{x:Static l:UiStrings.Import_Loading}" Classes="title" />
            <ProgressBar IsIndeterminate="True" />
            <TextBlock Text="{x:Static l:UiStrings.Import_LoadingHint}" Classes="muted" />
        </StackPanel>

        <StackPanel IsVisible="{Binding HasError}" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <c:OutlineIcon Data="{StaticResource IconWarning}" Width="24" Height="24" Foreground="{DynamicResource AppCancelInkBrush}" />
                <TextBlock Text="{x:Static l:UiStrings.Import_ErrorTitle}" Classes="title" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding StartManualCommand}">
                <TextBlock Text="{x:Static l:UiStrings.Import_EnterManually}" />
            </Button>
            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CloseCommand}">
                <TextBlock Text="{x:Static l:UiStrings.Common_Close}" />
            </Button>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsManualStep}" Spacing="16">
            <ContentControl Content="{Binding Manual}" />
            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CloseCommand}">
                <TextBlock Text="{x:Static l:UiStrings.Common_Cancel}" />
            </Button>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsReady}" Spacing="16">
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Static l:UiStrings.Import_Recognized}" Classes="title" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding EditManualCommand}" IsVisible="{Binding CameFromManual}">
                        <TextBlock Text="{x:Static l:UiStrings.Import_EditManual}" />
                    </Button>
                </Grid>
                <TextBlock Text="{Binding NewSummary}" Classes="muted" TextWrapping="Wrap" FontFeatures="+tnum" />
            </StackPanel>
            <Border Classes="soft" Padding="12,12,12,0">
                <ItemsControl ItemsSource="{Binding Legs}" ItemTemplate="{StaticResource LegTemplate}" />
            </Border>
            <TextBlock Text="{Binding Hint}" IsVisible="{Binding Hint, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource AppLateInkBrush}" />

            <StackPanel Spacing="8">
                <TextBlock Text="{x:Static l:UiStrings.Import_WhichShift}" Classes="caption" />
                <ItemsControl ItemsSource="{Binding Targets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImportTarget">
                            <RadioButton Classes="choice" GroupName="target" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding $parent[UserControl].((vm:ImportViewModel)DataContext).SelectTargetCommand}"
                                          CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                                        <Ellipse Stroke="{DynamicResource AppMutedBrush}" StrokeThickness="2" IsVisible="{Binding !IsSelected}" />
                                        <Ellipse Stroke="{DynamicResource AppAccentBrush}" StrokeThickness="6" IsVisible="{Binding IsSelected}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Text="{Binding NewShiftName}" PlaceholderText="{x:Static l:UiStrings.Import_NewShiftPlaceholder}"
                         IsVisible="{Binding IsNewTarget}" />
            </StackPanel>

            <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="8" Padding="4">
                <UniformGrid Rows="1">
                    <RadioButton Classes="segment" GroupName="direction" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsOutbound, Mode=OneWay}" Command="{Binding ChooseOutboundCommand}">
                        <TextBlock Text="{x:Static l:UiStrings.Common_Outbound}" />
                    </RadioButton>
                    <RadioButton Classes="segment" GroupName="direction" Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsReturn, Mode=OneWay}" Command="{Binding ChooseReturnCommand}">
                        <TextBlock Text="{x:Static l:UiStrings.Common_Return}" />
                    </RadioButton>
                </UniformGrid>
            </Border>

            <Border Classes="soft" IsVisible="{Binding HasReplacement}">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static l:UiStrings.Import_Replaced}" Classes="label" />
                    <TextBlock Text="{x:Static l:UiStrings.Import_Before}" Classes="caption" />
                    <TextBlock Text="{Binding ReplacedSummary}" TextWrapping="Wrap" Classes="muted" FontFeatures="+tnum" />
                    <TextBlock Text="{x:Static l:UiStrings.Import_After}" Classes="caption" />
                    <TextBlock Text="{Binding NewSummary}" TextWrapping="Wrap" FontFeatures="+tnum" />
                </StackPanel>
            </Border>

            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SaveCommand}">
                <TextBlock Text="{x:Static l:UiStrings.Common_Save}" />
            </Button>
            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CloseCommand}">
                <TextBlock Text="{x:Static l:UiStrings.Common_Cancel}" />
            </Button>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{x:Static l:UiStrings.Import_PatternHint}" />
        </StackPanel>
    </StackPanel>
</UserControl>
