<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:KackZug.Localization"
             xmlns:vm="using:KackZug.ViewModels"
             xmlns:c="using:KackZug.Controls"
             x:Class="KackZug.Views.TripsView"
             x:DataType="vm:TripsViewModel">
    <Grid>
        <ScrollViewer IsVisible="{Binding IsListVisible}">
            <StackPanel Margin="16" Spacing="12">
                <TextBlock Text="{x:Static l:UiStrings.Trips_Heading}" Classes="title-lg" />

                <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding CheckNowCommand}" IsVisible="{Binding !IsEmpty}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:OutlineIcon Data="{StaticResource IconRefresh}" Width="20" Height="20" />
                        <TextBlock Text="{x:Static l:UiStrings.Trips_CheckNow}" />
                    </StackPanel>
                </Button>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsChecking}" />

                <Border Classes="card" IsVisible="{Binding IsEmpty}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="8,16">
                        <c:OutlineIcon Data="{StaticResource IconTrain}" Width="48" Height="48" StrokeThickness="1.5" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Static l:UiStrings.Trips_EmptyTitle}" Classes="title" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Classes="muted"
                                   Text="{x:Static l:UiStrings.Trips_EmptyText}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Trips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OneOffTripCardViewModel">
                            <Border Classes="day">
                                <Grid ColumnDefinitions="6,*">
                                    <Border Background="{DynamicResource AppAccentBrush}" />
                                    <StackPanel Grid.Column="1" Margin="16,12,12,16" Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kicker}" Classes="kicker" IsVisible="{Binding HasKicker}" />
                                                <TextBlock Text="{Binding Name}" Classes="title" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                <TextBlock Text="{Binding DateText}" Classes="caption" FontFeatures="+tnum" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="icon" VerticalAlignment="Top" Margin="4,-4,-4,0"
                                                    ToolTip.Tip="{x:Static l:UiStrings.Trips_Delete}"
                                                    Command="{Binding $parent[UserControl].((vm:TripsViewModel)DataContext).DeleteCommand}"
                                                    CommandParameter="{Binding}">
                                                <c:OutlineIcon Data="{StaticResource IconDelete}" Width="20" Height="20" Foreground="{DynamicResource AppMutedBrush}" />
                                            </Button>
                                        </Grid>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding TimesText}" Classes="body-lg time" />
                                            <TextBlock Text="{Binding RouteText}" Classes="muted" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <ContentControl Content="{Binding Live.Badge}" ContentTemplate="{StaticResource BadgeTemplate}" VerticalAlignment="Center"
                                                            IsVisible="{Binding Live.Badge, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CheckedText}" Classes="caption" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Classes="ghost" Padding="8,0" MinHeight="40" VerticalAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:TripsViewModel)DataContext).OpenDetailCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{x:Static l:UiStrings.Week_Details}" />
                                                    <c:OutlineIcon Data="{StaticResource IconArrow}" Width="16" Height="16" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding Live.OpenInNavigatorCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <c:OutlineIcon Data="{StaticResource IconTrain}" Width="20" Height="20" />
                                                <TextBlock Text="{x:Static l:UiStrings.Detail_OpenNavigator}" IsVisible="{Binding !Live.IsPreparingNavigator}" />
                                                <TextBlock Text="{x:Static l:UiStrings.Detail_PreparingNavigator}" IsVisible="{Binding Live.IsPreparingNavigator}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding EnterManuallyCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:OutlineIcon Data="{StaticResource IconPlus}" Width="20" Height="20" />
                        <TextBlock Text="{x:Static l:UiStrings.Shifts_EnterManually}" />
                    </StackPanel>
                </Button>
                <TextBlock Classes="caption" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="{x:Static l:UiStrings.Shifts_EnterManuallyHint}" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding HasDetail}">
            <ContentControl Content="{Binding Detail}" Margin="16" ContentTemplate="{StaticResource TripDetailTemplate}" />
        </ScrollViewer>
    </Grid>
</UserControl>
