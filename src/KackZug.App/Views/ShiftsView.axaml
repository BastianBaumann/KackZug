<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KackZug.ViewModels"
             x:Class="KackZug.Views.ShiftsView"
             x:DataType="vm:ShiftsViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="ConnectionCardTemplate" x:DataType="vm:ConnectionCardViewModel">
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" Classes="h3" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" IsVisible="{Binding HasConnection}"
                                Command="{Binding RemoveCommand}" ToolTip.Tip="Fahrt entfernen">
                            <PathIcon Data="{StaticResource IconDelete}" Width="18" Height="18" />
                        </Button>
                    </Grid>
                    <TextBlock IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" Classes="muted"
                               Text="Noch keine Verbindung. Im DB Navigator auf „Teilen“ tippen und KackZug wählen." />
                    <ItemsControl ItemsSource="{Binding Legs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LegLine">
                                <Grid ColumnDefinitions="Auto,*" >
                                    <PathIcon Width="18" Height="18" Margin="0,2,10,0" VerticalAlignment="Top"
                                              Data="{StaticResource IconTrain}" IsVisible="{Binding !IsWalk}"
                                              Foreground="{DynamicResource AppAccentBrush}" />
                                    <PathIcon Width="18" Height="18" Margin="0,2,10,0" VerticalAlignment="Top"
                                              Data="{StaticResource IconWalk}" IsVisible="{Binding IsWalk}"
                                              Foreground="{DynamicResource AppMutedBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Times}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Route}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" Classes="muted" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer IsVisible="{Binding IsListVisible}">
            <StackPanel Margin="16" Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" Classes="h1" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="accent" Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconPlus}" Width="16" Height="16" Foreground="White" />
                            <TextBlock Text="Neue Schicht" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Classes="card" IsVisible="{Binding IsEmpty}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Noch keine Schicht" Classes="h3" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="Such im DB Navigator deine Verbindung zur Arbeit und tippe auf „Teilen“. Wähle dort KackZug aus. Die Verbindung landet dann als Hin- oder Rückfahrt in einer Schicht." />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Shifts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShiftCardViewModel">
                            <Button Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding $parent[UserControl].((vm:ShiftsViewModel)DataContext).EditCommand}"
                                    CommandParameter="{Binding}">
                                <Border Classes="card" Padding="0">
                                    <Grid ColumnDefinitions="6,*">
                                        <Border Background="{Binding ColorBrush}" CornerRadius="14,0,0,14" />
                                        <StackPanel Grid.Column="1" Margin="14,12" Spacing="6">
                                            <TextBlock Text="{Binding Name}" Classes="h3" />
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Hinfahrt" Classes="label" Margin="0" />
                                                <TextBlock Text="{Binding OutboundText}" TextWrapping="Wrap" FontSize="13" />
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Rückfahrt" Classes="label" Margin="0" />
                                                <TextBlock Text="{Binding ReturnText}" TextWrapping="Wrap" FontSize="13" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding IsEditing}">
            <ContentControl Content="{Binding Editor}" Margin="16">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:ShiftEditorViewModel">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{Binding Heading}" Classes="h1" />

                            <StackPanel>
                                <TextBlock Text="Name" Classes="label" />
                                <TextBox Text="{Binding Name}" PlaceholderText="z. B. Frühdienst" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Farbe" Classes="label" />
                                <ItemsControl ItemsSource="{Binding Colors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ColorOption">
                                            <Button Classes="icon" Margin="0,0,6,6" Padding="2" CornerRadius="20"
                                                    Command="{Binding $parent[ContentControl].((vm:ShiftEditorViewModel)DataContext).SelectColorCommand}"
                                                    CommandParameter="{Binding}">
                                                <Border Width="36" Height="36" CornerRadius="18" Background="{Binding Brush}">
                                                    <PathIcon Data="{StaticResource IconOk}" Width="18" Height="18" Foreground="White"
                                                              IsVisible="{Binding IsSelected}" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <ContentControl Content="{Binding Outbound}" ContentTemplate="{StaticResource ConnectionCardTemplate}" />
                            <ContentControl Content="{Binding Return}" ContentTemplate="{StaticResource ConnectionCardTemplate}" />

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Classes="ghost" Command="{Binding CancelCommand}">
                                    <TextBlock Text="Abbrechen" />
                                </Button>
                                <Button Classes="accent" Command="{Binding SaveCommand}">
                                    <TextBlock Text="Speichern" />
                                </Button>
                            </StackPanel>

                            <Button Classes="danger" IsVisible="{Binding CanDelete}" HorizontalAlignment="Left"
                                    Command="{Binding DeleteCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconDelete}" Width="16" Height="16" Foreground="White" />
                                    <TextBlock Text="Schicht löschen" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </ScrollViewer>
    </Grid>

</UserControl>
