<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KackZug.ViewModels"
             xmlns:c="using:KackZug.Controls"
             x:Class="KackZug.Views.ShiftsView"
             x:DataType="vm:ShiftsViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="ConnectionCardTemplate" x:DataType="vm:ConnectionCardViewModel">
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" Classes="title" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost" IsVisible="{Binding HasConnection}" Command="{Binding RemoveCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:OutlineIcon Data="{StaticResource IconDelete}" Width="18" Height="18" />
                                <TextBlock Text="Entfernen" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" Classes="muted"
                               Text="Noch keine Verbindung. Tipp im DB Navigator auf „Teilen“ und wähl KackZug." />
                    <ItemsControl ItemsSource="{Binding Legs}" ItemTemplate="{StaticResource LegTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer IsVisible="{Binding IsListVisible}">
            <StackPanel Margin="16" Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" Classes="title-lg" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="primary" Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:OutlineIcon Data="{StaticResource IconPlus}" Width="18" Height="18" />
                            <TextBlock Text="Neue Schicht" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Classes="card" IsVisible="{Binding IsEmpty}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="8,16">
                        <c:OutlineIcon Data="{StaticResource IconShare}" Width="48" Height="48" StrokeThickness="1.5" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Noch keine Schicht" Classes="title" HorizontalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Classes="muted"
                                   Text="Tipp im DB Navigator bei deiner Verbindung auf „Teilen“ und wähl KackZug. Sie landet dann als Hin- oder Rückfahrt in einer Schicht." />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Shifts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShiftCardViewModel">
                            <Button Classes="plain" HorizontalAlignment="Stretch"
                                    Command="{Binding $parent[UserControl].((vm:ShiftsViewModel)DataContext).EditCommand}"
                                    CommandParameter="{Binding}">
                                <Border Classes="day">
                                    <Grid ColumnDefinitions="6,*">
                                        <Border Background="{Binding ColorBrush}" />
                                        <StackPanel Grid.Column="1" Margin="16,12" Spacing="8">
                                            <Border Classes="badge" Background="{Binding ColorBrush}" HorizontalAlignment="Left" MinHeight="36" Padding="12,0" CornerRadius="8">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppOnShiftBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Hinfahrt" Classes="caption" />
                                                <TextBlock Text="{Binding OutboundText}" TextWrapping="Wrap" FontFeatures="+tnum" />
                                            </StackPanel>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Rückfahrt" Classes="caption" />
                                                <TextBlock Text="{Binding ReturnText}" TextWrapping="Wrap" FontFeatures="+tnum" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding EnterManuallyCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:OutlineIcon Data="{StaticResource IconTrain}" Width="20" Height="20" />
                        <TextBlock Text="Verbindung von Hand eingeben" />
                    </StackPanel>
                </Button>
                <TextBlock Classes="caption" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="Nur falls Teilen aus dem DB Navigator nicht klappt." />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding IsEditing}">
            <ContentControl Content="{Binding Editor}" Margin="16">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:ShiftEditorViewModel">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{Binding Heading}" Classes="title-lg" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Name" Classes="caption" />
                                <TextBox Text="{Binding Name}" PlaceholderText="z. B. Frühdienst" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Farbe" Classes="caption" />
                                <ItemsControl ItemsSource="{Binding Colors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ColorOption">
                                            <Button Classes="icon" Margin="0,0,4,4" Padding="4" CornerRadius="24"
                                                    Command="{Binding $parent[ItemsControl].((vm:ShiftEditorViewModel)DataContext).SelectColorCommand}"
                                                    CommandParameter="{Binding}">
                                                <Border Width="40" Height="40" CornerRadius="20" Background="{Binding Brush}">
                                                    <c:OutlineIcon Data="{StaticResource IconOk}" Width="22" Height="22" Foreground="{DynamicResource AppOnShiftBrush}"
                                                                   IsVisible="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <ContentControl Content="{Binding Outbound}" ContentTemplate="{StaticResource ConnectionCardTemplate}" />
                            <ContentControl Content="{Binding Return}" ContentTemplate="{StaticResource ConnectionCardTemplate}" />

                            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SaveCommand}">
                                <TextBlock Text="Speichern" />
                            </Button>
                            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}">
                                <TextBlock Text="Abbrechen" />
                            </Button>
                            <Button Classes="secondary destructive" IsVisible="{Binding CanDelete}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding DeleteCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <c:OutlineIcon Data="{StaticResource IconDelete}" Width="18" Height="18" />
                                    <TextBlock Text="Schicht löschen" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </ScrollViewer>
    </Grid>
</UserControl>
