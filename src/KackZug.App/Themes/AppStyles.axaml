<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:KackZug.Controls">
    <!-- Komponenten-Stile nach dem KackZug-Designsystem (bundle.css), Werte aus Tokens.axaml -->

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.title-lg">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.body-lg">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.time">
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.kicker">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentInkBrush}" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="Margin" Value="4,12,0,4" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}" />
    </Style>
    <Style Selector="Border.soft">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.day">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="88" />
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.day.today">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.day.past">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Border.day.past TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppDisabledBrush}" />
    </Style>
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="Border.line-tag">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.setting">
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.group">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Button, ToggleButton, TextBox, ComboBox, NumericUpDown, TimePicker">
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBox, ComboBox">
        <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="NumericUpDown, TimePicker">
        <Setter Property="Height" Value="48" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter, Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    </Style>
    <Style Selector="Button.primary TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary c|OutlineIcon">
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppDisabledBrush}" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="Button.secondary.destructive TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppCancelInkBrush}" />
    </Style>
    <Style Selector="Button.secondary.destructive c|OutlineIcon">
        <Setter Property="Foreground" Value="{DynamicResource AppCancelInkBrush}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentInkBrush}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    </Style>
    <Style Selector="Button.ghost TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentInkBrush}" />
    </Style>
    <Style Selector="Button.ghost c|OutlineIcon">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentInkBrush}" />
    </Style>

    <Style Selector="Button.plain">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.plain /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.tab">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Button.tab /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.tab.selected">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentInkBrush}" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Padding" Value="10" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    </Style>

    <Style Selector="ToggleButton.trip">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.trip /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToggleButton.trip:checked /template/ ContentPresenter, ToggleButton.trip:pointerover /template/ ContentPresenter, ToggleButton.trip:checked:pointerover /template/ ContentPresenter, ToggleButton.trip:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="ToggleButton.trip TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="ToggleButton.trip:unchecked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDisabledBrush}" />
    </Style>
    <Style Selector="ToggleButton.trip:unchecked TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppDisabledBrush}" />
        <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>

    <Style Selector="ToggleButton.choice">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.choice /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToggleButton.choice:checked /template/ ContentPresenter, ToggleButton.choice:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ToggleButton.choice:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="ToggleButton.choice TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <Style Selector="ToggleButton.segment">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.segment /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ToggleButton.segment TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter, ToggleButton.segment:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}" />
    </Style>
    <Style Selector="ToggleButton.segment:checked TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.segment:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="RadioButton.segment">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.segment /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="RadioButton.segment TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ ContentPresenter, RadioButton.segment:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}" />
    </Style>
    <Style Selector="RadioButton.segment:checked TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="RadioButton.segment:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="RadioButton.choice">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.choice /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="RadioButton.choice:checked /template/ ContentPresenter, RadioButton.choice:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="RadioButton.choice:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="RadioButton.choice TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <Style Selector="Border.dot">
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="Border.dot.current">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <Style Selector="ComboBox.shift">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,0,4,0" />
    </Style>
</Styles>
